{
  "name": "smartcart",
  "version": "1.0.0",
  "private": true,
  "description": "SmartCart - AI-Powered Product Recommendation System using Vector Embeddings",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
